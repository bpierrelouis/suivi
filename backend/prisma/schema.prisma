generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  administrateur
  gestionnaire
  utilisateur
}

enum VisibiliteProjet {
  public
  prive
}

enum StatutProjet {
  actif
  archive
}

enum EtatTache {
  a_faire
  en_cours
  terminee
}

enum ModeSuiviMateriel {
  individualise
  non_individualise
}

enum StatutMateriel {
  actif
  archive
}

enum TypeEvenementMateriel {
  creation
  modification
  ajout_piece_jointe
  retrait_piece_jointe
  archivage
}

enum StatutReservation {
  active
  annulee
  liberee
}

enum TypeEvenementReservation {
  creation
  modification
  annulation
  liberation
}

enum TypeEvenementProjet {
  creation
  modification
  ajout_membre
  retrait_membre
  creation_tache
  modification_tache
  suppression_tache
  archivage
}

enum TypeNotification {
  materiel_archive
  reservation_liberee
}

model Utilisateur {
  id                      String                  @id @default(uuid()) @db.Uuid
  identifiant             String                  @unique
  motDePasse              String                  @map("mot_de_passe")
  role                    Role                    @default(utilisateur)
  creeLe                  DateTime                @default(now()) @map("cree_le") @db.Timestamptz(3)
  derniereConnexion       DateTime?               @map("derniere_connexion") @db.Timestamptz(3)
  projetsResponsables     Projet[]                @relation("ResponsableProjet")
  participations          Participation[]
  tachesAssignees         Tache[]                 @relation("ResponsableTache")
  documentationsModifiees DocumentationProjet[]   @relation("AuteurDocumentation")
  materielsCrees          Materiel[]              @relation("AuteurCreationMateriel")
  historiquesMateriel     HistoriqueMateriel[]    @relation("AuteurEvenementMateriel")
  piecesJointesMateriel   PieceJointeMateriel[]   @relation("AuteurPieceJointeMateriel")
  materielsArchives       Materiel[]              @relation("AuteurArchivageMateriel")
  reservationsCreees      Reservation[]           @relation("CreateurReservation")
  reservationsAnnulees    Reservation[]           @relation("AuteurAnnulationReservation")
  historiquesReservation  HistoriqueReservation[] @relation("AuteurEvenementReservation")
  historiquesProjet       HistoriqueProjet[]      @relation("AuteurEvenementProjet")
  notifications           Notification[]          @relation("DestinataireNotification")

  @@map("utilisateurs")
}

model Materiel {
  id                    String                @id @default(uuid()) @db.Uuid
  nom                   String
  modeSuivi             ModeSuiviMateriel     @default(individualise) @map("mode_suivi")
  numeroSerie           String?               @map("numero_serie")
  referenceConstructeur String?               @map("reference_constructeur")
  numeroInventaire      String?               @map("numero_inventaire")
  statut                StatutMateriel        @default(actif)
  auteurCreationId      String                @map("auteur_creation_id") @db.Uuid
  auteurCreation        Utilisateur           @relation("AuteurCreationMateriel", fields: [auteurCreationId], references: [id], onDelete: Restrict)
  categories            MaterielCategorie[]
  historique            HistoriqueMateriel[]
  piecesJointes         PieceJointeMateriel[]
  archiveLe             DateTime?             @map("archive_le") @db.Timestamptz(3)
  archiveParId          String?               @map("archive_par_id") @db.Uuid
  archivePar            Utilisateur?          @relation("AuteurArchivageMateriel", fields: [archiveParId], references: [id], onDelete: Restrict)
  reservations          Reservation[]
  creeLe                DateTime              @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe             DateTime              @updatedAt @map("modifie_le") @db.Timestamptz(3)

  @@index([statut, nom])
  @@map("materiels")
}

model Categorie {
  id        String              @id @default(uuid()) @db.Uuid
  nom       String              @unique
  materiels MaterielCategorie[]
  creeLe    DateTime            @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe DateTime            @updatedAt @map("modifie_le") @db.Timestamptz(3)

  @@map("categories")
}

model MaterielCategorie {
  materielId  String    @map("materiel_id") @db.Uuid
  categorieId String    @map("categorie_id") @db.Uuid
  materiel    Materiel  @relation(fields: [materielId], references: [id], onDelete: Cascade)
  categorie   Categorie @relation(fields: [categorieId], references: [id], onDelete: Cascade)

  @@id([materielId, categorieId])
  @@index([categorieId])
  @@map("materiels_categories")
}

model HistoriqueMateriel {
  id         String                @id @default(uuid()) @db.Uuid
  materielId String                @map("materiel_id") @db.Uuid
  materiel   Materiel              @relation(fields: [materielId], references: [id], onDelete: Restrict)
  type       TypeEvenementMateriel
  details    Json?
  auteurId   String                @map("auteur_id") @db.Uuid
  auteur     Utilisateur           @relation("AuteurEvenementMateriel", fields: [auteurId], references: [id], onDelete: Restrict)
  creeLe     DateTime              @default(now()) @map("cree_le") @db.Timestamptz(3)

  @@index([materielId, creeLe])
  @@map("historique_materiels")
}

model PieceJointeMateriel {
  id         String      @id @default(uuid()) @db.Uuid
  materielId String      @map("materiel_id") @db.Uuid
  materiel   Materiel    @relation(fields: [materielId], references: [id], onDelete: Restrict)
  nomFichier String      @map("nom_fichier")
  typeMime   String      @map("type_mime")
  taille     Int
  cleObjet   String      @unique @map("cle_objet")
  empreinte  String
  etat       String      @default("en_attente")
  auteurId   String      @map("auteur_id") @db.Uuid
  auteur     Utilisateur @relation("AuteurPieceJointeMateriel", fields: [auteurId], references: [id], onDelete: Restrict)
  ajouteLe   DateTime    @default(now()) @map("ajoute_le") @db.Timestamptz(3)

  @@index([materielId, ajouteLe])
  @@map("pieces_jointes_materiels")
}

model Projet {
  id             String               @id @default(uuid()) @db.Uuid
  nom            String
  description    String
  visibilite     VisibiliteProjet
  statut         StatutProjet         @default(actif)
  dateDebut      DateTime?            @map("date_debut") @db.Date
  dateFin        DateTime?            @map("date_fin") @db.Date
  responsableId  String               @map("responsable_id") @db.Uuid
  responsable    Utilisateur          @relation("ResponsableProjet", fields: [responsableId], references: [id], onDelete: Restrict)
  participations Participation[]
  taches         Tache[]
  documentation  DocumentationProjet?
  reservations   Reservation[]
  historique     HistoriqueProjet[]
  creeLe         DateTime             @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe      DateTime             @updatedAt @map("modifie_le") @db.Timestamptz(3)

  @@index([statut, visibilite])
  @@map("projets")
}

model Reservation {
  id              String                  @id @default(uuid()) @db.Uuid
  materielId      String                  @map("materiel_id") @db.Uuid
  materiel        Materiel                @relation(fields: [materielId], references: [id], onDelete: Restrict)
  projetId        String                  @map("projet_id") @db.Uuid
  projet          Projet                  @relation(fields: [projetId], references: [id], onDelete: Restrict)
  reserveParId    String                  @map("reserve_par_id") @db.Uuid
  reservePar      Utilisateur             @relation("CreateurReservation", fields: [reserveParId], references: [id], onDelete: Restrict)
  debut           DateTime                @db.Timestamptz(3)
  fin             DateTime                @db.Timestamptz(3)
  statut          StatutReservation       @default(active)
  annuleLe        DateTime?               @map("annule_le") @db.Timestamptz(3)
  annuleParId     String?                 @map("annule_par_id") @db.Uuid
  annulePar       Utilisateur?            @relation("AuteurAnnulationReservation", fields: [annuleParId], references: [id], onDelete: Restrict)
  motifAnnulation String?                 @map("motif_annulation")
  historique      HistoriqueReservation[]
  creeLe          DateTime                @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe       DateTime                @updatedAt @map("modifie_le") @db.Timestamptz(3)

  @@index([projetId, debut])
  @@index([materielId, debut])
  @@map("reservations")
}

model HistoriqueReservation {
  id            String                   @id @default(uuid()) @db.Uuid
  reservationId String                   @map("reservation_id") @db.Uuid
  reservation   Reservation              @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  type          TypeEvenementReservation
  details       Json?
  auteurId      String?                  @map("auteur_id") @db.Uuid
  auteur        Utilisateur?             @relation("AuteurEvenementReservation", fields: [auteurId], references: [id], onDelete: Restrict)
  creeLe        DateTime                 @default(now()) @map("cree_le") @db.Timestamptz(3)

  @@index([reservationId, creeLe])
  @@map("historique_reservations")
}

model HistoriqueProjet {
  id       String              @id @default(uuid()) @db.Uuid
  projetId String              @map("projet_id") @db.Uuid
  projet   Projet              @relation(fields: [projetId], references: [id], onDelete: Restrict)
  type     TypeEvenementProjet
  details  Json?
  auteurId String?             @map("auteur_id") @db.Uuid
  auteur   Utilisateur?        @relation("AuteurEvenementProjet", fields: [auteurId], references: [id], onDelete: Restrict)
  creeLe   DateTime            @default(now()) @map("cree_le") @db.Timestamptz(3)

  @@index([projetId, creeLe])
  @@map("historique_projets")
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  destinataireId String           @map("destinataire_id") @db.Uuid
  destinataire   Utilisateur      @relation("DestinataireNotification", fields: [destinataireId], references: [id], onDelete: Restrict)
  type           TypeNotification
  titre          String
  message        String
  details        Json?
  luLe           DateTime?        @map("lu_le") @db.Timestamptz(3)
  creeLe         DateTime         @default(now()) @map("cree_le") @db.Timestamptz(3)

  @@index([destinataireId, luLe, creeLe])
  @@map("notifications")
}

model Tache {
  id            String       @id @default(uuid()) @db.Uuid
  projetId      String       @map("projet_id") @db.Uuid
  projet        Projet       @relation(fields: [projetId], references: [id], onDelete: Cascade)
  titre         String
  description   String
  etat          EtatTache    @default(a_faire)
  ordre         Int          @default(0)
  responsableId String?      @map("responsable_id") @db.Uuid
  responsable   Utilisateur? @relation("ResponsableTache", fields: [responsableId], references: [id], onDelete: SetNull)
  creeLe        DateTime     @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe     DateTime     @updatedAt @map("modifie_le") @db.Timestamptz(3)

  @@index([projetId, etat, ordre])
  @@map("taches")
}

model DocumentationProjet {
  projetId  String      @id @map("projet_id") @db.Uuid
  projet    Projet      @relation(fields: [projetId], references: [id], onDelete: Cascade)
  contenu   String      @default("")
  auteurId  String      @map("auteur_id") @db.Uuid
  auteur    Utilisateur @relation("AuteurDocumentation", fields: [auteurId], references: [id], onDelete: Restrict)
  modifieLe DateTime    @updatedAt @map("modifie_le") @db.Timestamptz(3)

  @@map("documentations_projets")
}

model Participation {
  projetId      String      @map("projet_id") @db.Uuid
  utilisateurId String      @map("utilisateur_id") @db.Uuid
  projet        Projet      @relation(fields: [projetId], references: [id], onDelete: Cascade)
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)
  rejointLe     DateTime    @default(now()) @map("rejoint_le") @db.Timestamptz(3)

  @@id([projetId, utilisateurId])
  @@index([utilisateurId])
  @@map("participations_projets")
}
